@startuml
title Activity Diagram - View Explainable Results
top to bottom direction

skinparam shadowing false
skinparam dpi 180
skinparam activity {
  BackgroundColor White
  BorderColor Black
  FontSize 14
}
skinparam note {
  BackgroundColor #FFF8C6
  BorderColor Black
  FontSize 12
}

note top
Steps:
1) Open TaskResult
2) Display answer + confidence
3) Show EvidenceRefs
4) If user opens evidence, jump to page/timestamp in asset
5) Export/share or add feedback
6) Save audit trail
end note

(*) --> "1. Open TaskResult"
--> "2. Display answer\n+ confidence"
--> "3. Show EvidenceRefs"
--> "Open evidence?"

if (Open evidence?) then (Yes)
  --> "4. Jump to page/timestamp\nin asset"
endif

--> "5. Export/share\nor add feedback"
--> "6. Save audit trail"
--> (*)

@enduml